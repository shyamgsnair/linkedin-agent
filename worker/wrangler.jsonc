/**
 * li-agent: remote MCP server for drafting, publishing and resharing LinkedIn posts.
 * Wrangler config reference: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Secrets are never stored here. Set them with:
 *   npx wrangler secret put LINKEDIN_CLIENT_ID
 *   npx wrangler secret put LINKEDIN_CLIENT_SECRET
 *   npx wrangler secret put COOKIE_ENCRYPTION_KEY
 *   npx wrangler secret put ALLOWED_MEMBER_ID
 * For local development, put the same names in worker/.dev.vars (gitignored).
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "li-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // MCP session state. The free plan requires SQLite-backed Durable Objects.
  "migrations": [{ "new_sqlite_classes": ["LinkedInMCP"], "tag": "v1" }],
  "durable_objects": {
    "bindings": [{ "class_name": "LinkedInMCP", "name": "MCP_OBJECT" }]
  },

  "kv_namespaces": [
    // OAuth grants and tokens (managed by workers-oauth-provider; the LinkedIn token is stored encrypted).
    // Create with: npx wrangler kv namespace create OAUTH_KV   (then paste the id below)
    { "binding": "OAUTH_KV", "id": "REPLACE_WITH_OAUTH_KV_ID" },
    // Agent data: config (voice guide, watchlist), post history, duplicate-check hashes.
    // Create with: npx wrangler kv namespace create DATA_KV    (then paste the id below)
    { "binding": "DATA_KV", "id": "REPLACE_WITH_DATA_KV_ID" }
  ],

  // Per-IP rate limit on the sign-in and registration endpoints.
  "ratelimits": [
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],

  "vars": {
    // Pin the LinkedIn API version (YYYYMM). Bump deliberately; LinkedIn retires versions after about a year.
    "LINKEDIN_API_VERSION": "202608",
    // Set to "true" only if you also connect from Claude Code or the MCP Inspector (localhost callbacks).
    "ALLOW_LOCALHOST_CLIENTS": "false"
  },

  "observability": { "enabled": true },
  "dev": { "port": 8788 }
}
